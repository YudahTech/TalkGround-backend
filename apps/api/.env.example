DATABASE_URL="postgresql://postgres:password@localhost:5433/talkground?schema=public"
JWT_SECRET="change-me-in-production-use-at-least-32-random-chars"
# Access token lifetime: 15 minutes or less (PRD v2.5 §7.1). The API caps it at 15m.
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
PORT=3001
# Comma-separated list of allowed web origins (also used for the CSRF origin check on cookie requests)
CORS_ORIGIN="http://localhost:3000"
# CORS_ALLOW_LOCALHOST=true
# Where password-reset links point (defaults to the first CORS_ORIGIN)
FRONTEND_URL="http://localhost:3000"

# Auth is HttpOnly-cookie only (talkground_at / talkground_rt). No tokens in JSON, no Bearer header.
# Web and API on different sites (vercel.app -> onrender.com) need: COOKIE_SAMESITE=none
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com
# Render sits behind one proxy hop; needed for real client IPs (rate limits, fraud flags)
# TRUST_PROXY=1

# PRD v2.5 config flags (defaults shown). Threshold changes need an approved PRD change.
# REQUIRE_PHONE_VERIFIED_FOR_REVIEWS=false
# REVIEW_REQUIRE_EMAIL_VERIFIED=true
# MIN_REVIEWS_FOR_RATING=3
# REVIEW_DAILY_LIMIT=3
# REVIEW_BODY_MIN_LENGTH=50
# INDEXABLE_MIN_DESCRIPTION_CHARS=80
# INDEXABLE_MIN_REVIEWS=0
# INDEXABLE_MIN_LISTINGS=5
# PUBLIC_CACHE_MAX_MINUTES=15
# On-demand revalidation webhook on the frontend (optional, PRD 7.13)
# FRONTEND_REVALIDATE_URL=https://talkground.ng/api/revalidate
# REVALIDATE_SECRET=change-me-long-random-string

# Seed (local/staging only — refuses NODE_ENV=production). Unset = generated and printed once.
# SEED_DEMO_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_RESET_PASSWORDS=false

# OTP / SMS — Termii
# OTP_DEV_MODE=true -> no SMS; the code is returned in the API response as devCode. TESTING ONLY.
OTP_DEV_MODE=true
TERMII_API_KEY=""
TERMII_SENDER_ID="TalkGround"

# Cloudinary — optional for early dev (text-only reviews work without uploads)
# Required for profile avatars and review photos/receipts
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email — Brevo (transactional). EMAIL_FROM must be a verified sender/domain in Brevo.
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="TalkGround"
# EMAIL_DEV_MODE=true -> email codes returned in API responses as devCode/devEmailCode. TESTING ONLY.
EMAIL_DEV_MODE=false
