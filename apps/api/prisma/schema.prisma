generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BrandCategory {
  RESTAURANTS
  HOTELS
}

enum RestaurantSubType {
  CASUAL
  FAST_FOOD
  FINE_DINING
  BUKA
}

enum HotelSubType {
  HOTEL
  GUEST_HOUSE
  SHORT_LET
}

enum City {
  LAGOS
  ABUJA
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum ReviewStatus {
  PUBLISHED
  PENDING_VERIFICATION
  FLAGGED
  SUSPENDED
  REMOVED
}

enum MediaType {
  PHOTO
  RECEIPT
}

enum FlagType {
  IP_MATCH
  DUPLICATE_TEXT
  VELOCITY
  NEW_ACCOUNT_LOW_RATING
  MANUAL
}

enum ReportReason {
  FAKE_SPAM
  NEVER_VISITED
  OFFENSIVE
  PAID_INCENTIVIZED
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrimaryUse {
  RESTAURANTS
  HOTELS
  BOTH
  WRITE_REVIEWS
}

enum ReviewInterest {
  RESTAURANTS
  HOTELS
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  username      String    @unique
  phone         String?
  bio           String?
  avatarUrl     String?
  city          City?
  interests     ReviewInterest[]
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  role          UserRole  @default(USER)
  suspended     Boolean   @default(false)
  suspendedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviews           Review[]
  reports           ReviewReport[]
  brandSuggestions  BrandSuggestion[]
  otpCodes          OtpCode[]
  helpfulVotes      ReviewHelpfulVote[]
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  logoUrl     String?
  website     String?
  category    BrandCategory
  subType     String?
  tags        String[]          @default([])
  city        City
  area        String
  claimed     Boolean           @default(false)
  status      BrandStatus       @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  reviews     Review[]
}

model Review {
  id             String       @id @default(uuid())
  brandId        String
  userId         String
  rating         Int
  title          String
  body           String
  pros           String?
  cons           String?
  recommend      Boolean
  status         ReviewStatus @default(PUBLISHED)
  verifiedVisit  Boolean      @default(false)
  viewCount      Int          @default(0)
  ipHash         String?
  textHash       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  brand         Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         ReviewMedia[]
  flags         ReviewFlag[]
  reports       ReviewReport[]
  helpfulVotes  ReviewHelpfulVote[]

  @@unique([brandId, userId])
}

model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model ReviewMedia {
  id        String    @id @default(uuid())
  reviewId  String
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewFlag {
  id        String   @id @default(uuid())
  reviewId  String
  type      FlagType
  metadata  Json?
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewReport {
  id         String       @id @default(uuid())
  reviewId   String
  reporterId String
  reason     ReportReason
  note       String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model BrandSuggestion {
  id        String           @id @default(uuid())
  userId    String
  name      String
  category  BrandCategory
  subType   String?
  city      City
  area      String
  website   String?
  status    SuggestionStatus @default(PENDING)
  adminNote String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SurveyResponse {
  id        String   @id @default(uuid())
  answers   Json
  email     String?
  city      String?
  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  phone        String?
  city         City
  primaryUse   PrimaryUse
  attribution  String?
  consentGiven Boolean    @default(true)
  invitedAt    DateTime?
  registeredAt DateTime?
  createdAt    DateTime   @default(now())
}
